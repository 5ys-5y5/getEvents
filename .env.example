# Financial Modeling Prep API Key
# Get your API key from: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=8AP6lUDNsrBwtx5IzVoDliKnG186rBSt

# Server Configuration
PORT=3000
NODE_ENV=development

# API Rate Limiting
# FMP rate limits: 4 requests/second parallel
FMP_MAX_CONCURRENT_REQUESTS=10
FMP_REQUEST_TIMEOUT_MS=30000

# Cache Configuration
SYMBOL_CACHE_EXPIRY_DAYS=7

# Supabase Database Configuration (REQUIRED for database features)
# Get credentials from: https://app.supabase.com/project/_/settings/api
# 1. Go to your Supabase project dashboard
# 2. Navigate to Settings > API
# 3. Copy the "Project URL" to SUPABASE_URL
# 4. Copy the "anon public" key to SUPABASE_ANON_KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Set to 'false' to disable database features (file-based cache only)
USE_DATABASE=true
